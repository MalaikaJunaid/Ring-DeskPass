# Ring Developer App Credentials
RING_CLIENT_ID=your_client_id_here
RING_CLIENT_SECRET=your_client_secret_here
RING_HMAC_SIGN_KEY=your_hmac_sign_key_here

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Kiro Crew Orchestrator (if utilizing an auth token or workspace key)
KIRO_CREW_TOKEN=your_kiro_token_here

# AWS Settings (Optional fallback if not using ~/.aws/credentials)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
CLOUDWATCH_LOG_GROUP="RingSecureKioskLogs"
AWS_HARNESS_ID="your_harness_id_or_arn"

OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T000.../YOUR_WEBHOOK_HERE"

RING_USERNAME="your-new-email@example.com"
RING_PASSWORD="your-new-password"